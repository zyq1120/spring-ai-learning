# 复制为 .env 后填入自己的值。.env 已在 .gitignore 中，绝不要提交真实 Key。
# IntelliJ IDEA 中可在 Run Configuration -> Environment variables 里逐项填，
# 或使用 EnvFile 插件加载本文件。

# ---- 大模型 API（第 1 周必需）----
# 服务商标识（记录用；真正切换服务商靠 BASE_URL + MODEL + 对应 Starter）
AI_PROVIDER=openai
# 服务商提供的 API 地址（OpenAI 兼容接口地址）
AI_BASE_URL=https://api.openai.com
# API Key：只放本地环境变量 / .env，绝不提交到 Git
AI_API_KEY=
# 服务商支持的模型 ID
AI_MODEL=gpt-4o-mini

# ---- 数据库（第 4 周起使用，与 docker-compose.yml 默认值对应）----
# DB_URL=jdbc:mysql://localhost:3306/spring_ai_learning?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
# DB_USERNAME=springai
# DB_PASSWORD=springai123
# REDIS_HOST=localhost
# REDIS_PORT=6379
# PGVECTOR_URL=jdbc:postgresql://localhost:5432/spring_ai_knowledge
# PGVECTOR_USERNAME=postgres
# PGVECTOR_PASSWORD=springai123
